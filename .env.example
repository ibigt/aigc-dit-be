# 复制为 .env 后按需修改。不提供时 compose 使用同名默认值。
# Linux 服务器数据根；Windows Docker Desktop 可改为 E:/data/ai-gc 或 ./data
DIT_DATA_ROOT=/mnt/ai-gc

POSTGRES_USER=fnii
POSTGRES_PASSWORD=Fnii@123
POSTGRES_DB=dit
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_PASSWORD=

MINIO_ROOT_USER=ditminio
MINIO_ROOT_PASSWORD=DitMinio123
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 切到 OSS/COS 时只改下面几项（backend 容器内可达的 endpoint）
S3_ENDPOINT=http://minio:9000
S3_BUCKET=dit
S3_ACCESS_KEY=ditminio
S3_SECRET_KEY=DitMinio123
S3_REGION=us-east-1

JWT_SECRET=dit-dev-jwt-secret-change-me-32b
CRYPTO_SECRET=dit-dev-crypto-secret-change-me-32b
DIT_ADMIN_USERNAME=admin
DIT_ADMIN_PASSWORD=Fnii@123

# 页面入口：http://<IP>:8088/login （不要用后端 8080，那是 API）
FRONTEND_PORT=8088
BACKEND_PORT=18080

# 启用 ComfyUI：COMFYUI_ENABLED=true docker compose --profile comfy up --build
COMFYUI_ENABLED=false
COMFYUI_BASE_URL=http://comfyui:8188
COMFYUI_PORT=8188

# RunningHub。优先用管理后台写入的模型密钥（加密落库）；这里可留空作回退。
# 禁止把真实 Key 提交进仓库。max-calls=0 表示不限制次数。
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.ai
RUNNINGHUB_MAX_CALLS=0
GENERATE_TIMEOUT_SECONDS=600
